# ==============================================================================
# CONFIGURAÇÃO DO SISTEMA INSTAGRAM SDR & PROSPECÇÃO AUTÔNOMA VIA ADB (.env)
# Copie este arquivo para `.env` na raiz do projeto e preencha seus dados:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERIAIS DOS CELULARES ANDROID (ADB)
# Rode `adb devices` no terminal com os celulares plugados via USB para ver os seriais.
# Se deixar em branco, o sistema detecta automaticamente os aparelhos conectados!
# ------------------------------------------------------------------------------
SERIAL_OLHEIRO=
SERIAL_SNIPER=

# Caminho opcional para o executável adb.exe e scrcpy.exe (se já estiverem no PATH do Windows, deixe em branco)
ADB_PATH=
SCRCPY_PATH=

# ------------------------------------------------------------------------------
# 2. CHAVES DE IA (OPCIONAIS — O SISTEMA POSSUI FAST-PATH LOCAL 0ms GRATUITO)
# ------------------------------------------------------------------------------
# DeepSeek API Key (Opcional: usada para classificar bios complexas no megazord_prospeccao.py)
DEEPSEEK_API_KEY=

# Google Gemini API Key (Opcional: usada apenas nos scripts da pasta scripts_extras/)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. PERSONALIZAÇÃO DO OPERADOR, COPY DE ABORDAGEM E OFERTA (CRM & AUTO-RESPONDER)
# ------------------------------------------------------------------------------
SDR_OPERATOR_NAME=SeuNome
SDR_CONTACT_EMAIL=seuemail@gmail.com
SDR_CONTACT_WHATSAPP=(11) 99999-9999
SDR_PRICE_RANGE=R$ 40 a R$ 50

# Copy padrão de 1ª abordagem enviada pelo Sniper (use {primeiro_nome} para inserir o nome do lead e \n para quebra de linha)
SDR_DEFAULT_OUTREACH_COPY=Oi {primeiro_nome} tudo bem?\nOlha, quantos videos seu editor de videos esta entregando atualmente?

# ------------------------------------------------------------------------------
# 4. PARÂMETROS AVANÇADOS E DASHBOARD WEB CRM
# ------------------------------------------------------------------------------
TARGET_MARKET=BR
CRM_WEB_PORT=4950
SAVE_DEBUG_FRAMES=0
